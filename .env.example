# Region for S3 and DynamoDB.
AWS_REGION=ap-south-1

# Region Bedrock is called in. Deliberately separate from AWS_REGION, because
# Claude model access is not enabled in every region. Point it wherever the
# model is actually available and leave the data services in ap-south-1.
BEDROCK_REGION=ap-south-1

# Bedrock model IDs carry the "anthropic." prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Bill photo bucket.
BILLS_BUCKET=kiranaledger-bills-CHANGEME

# Single-table ledger store.
LEDGER_TABLE=KiranaLedger
