# ---------------------------------------------------------------------------
# Set all of these in Amplify.
# ---------------------------------------------------------------------------

# Region for S3 and DynamoDB. Named APP_REGION rather than AWS_REGION because
# Amplify reserves the "AWS" prefix and fails the build if you set one.
APP_REGION=ap-south-1

# Region Bedrock is called in. Deliberately separate from APP_REGION, since
# Claude model access is not enabled in every region.
BEDROCK_REGION=ap-south-1

# Vision model that reads the bill photo. Accuracy matters most here, and
# Bedrock model IDs carry the "anthropic." prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Writes the flag explanation from facts the code already computed. No
# reasoning required, and it sits on the upload path, so speed wins.
BEDROCK_EXPLAIN_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Bill photo bucket.
BILLS_BUCKET=kiranaledger-bills-CHANGEME

# Single-table ledger store.
LEDGER_TABLE=KiranaLedger

# ---------------------------------------------------------------------------
# Local only. Never set these in Amplify, it rejects the "AWS" prefix and the
# SSR runtime supplies the equivalents itself.
# ---------------------------------------------------------------------------

# Pins every AWS call to the hackathon account, never the work default.
AWS_PROFILE=kirana
